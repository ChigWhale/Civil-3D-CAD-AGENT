<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>CADAgent</AssemblyName>
    <RootNamespace>CADAgent</RootNamespace>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputPath></OutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Auto-detect Civil 3D installation -->
  <PropertyGroup>
    <AutoCADPath>$([System.IO.Directory]::GetDirectories('C:\Program Files\Autodesk','AutoCAD 20*')[0])</AutoCADPath>
    <Civil3DPath>$(AutoCADPath)\C3D</Civil3DPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

  <!-- UI is built entirely in code — exclude the XAML file from compilation -->
  <ItemGroup>
    <Page Remove="AgentPaletteControl.xaml" />
    <None Include="AgentPaletteControl.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- AutoCAD core references -->
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCADPath)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AutoCADPath)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AutoCADPath)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Ribbon (Autodesk.Windows): the CAD-AGENT tab in Ribbon.cs -->
    <Reference Include="AdWindows">
      <HintPath>$(AutoCADPath)\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Civil3D database API -->
    <Reference Include="AeccDbMgd">
      <HintPath>$(Civil3DPath)\AeccDbMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Pressure networks (water): PressurePipeNetwork, PressurePipe, fittings, appurtenances
         and the CivilDocument.GetPressurePipeNetworkIds extension live in their own assembly -->
    <Reference Include="AeccPressurePipesMgd">
      <HintPath>$(Civil3DPath)\AeccPressurePipesMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- AEC base types required by Civil3D objects (Entity, Handle, etc.) -->
    <Reference Include="AecBaseMgd">
      <HintPath>$(AutoCADPath)\ACA\AecBaseMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- PipeInvertSetter is its own project; keep its sources out of this assembly -->
  <ItemGroup>
    <Compile Remove="PipeInvertSetter\**" />
    <None Remove="PipeInvertSetter\**" />
    <Compile Remove="PipeInvertSetter.Tests\**" />
    <None Remove="PipeInvertSetter.Tests\**" />
    <Compile Remove="ReeseOclock\**" />
    <None Remove="ReeseOclock\**" />
    <EmbeddedResource Remove="ReeseOclock\**" />
    <Compile Remove="Gambol\**" />
    <None Remove="Gambol\**" />
    <EmbeddedResource Remove="Gambol\**" />
    <Compile Remove="MathDrill\**" />
    <None Remove="MathDrill\**" />
    <EmbeddedResource Remove="MathDrill\**" />
    <Compile Remove="FeatureLineSync\**" />
    <None Remove="FeatureLineSync\**" />
    <EmbeddedResource Remove="FeatureLineSync\**" />
    <Compile Remove="FeatureLineSync.Tests\**" />
    <None Remove="FeatureLineSync.Tests\**" />
    <EmbeddedResource Remove="FeatureLineSync.Tests\**" />
    <Compile Remove="FeatureLineGrades\**" />
    <None Remove="FeatureLineGrades\**" />
    <EmbeddedResource Remove="FeatureLineGrades\**" />
  </ItemGroup>

  <!-- Pipe elevation solver (ICadObjectHandler) exposed through /handler -->
  <ItemGroup>
    <ProjectReference Include="PipeInvertSetter\PipeInvertSetter.csproj" />
  </ItemGroup>

  <!-- Developer autoload: once package\install-dev-bundle.ps1 has created the
       Autodesk bundle, every build copies its output there, so the next Civil 3D
       start loads the newest DLL and its ribbon tab without NETLOAD. A copy that
       fails because Civil 3D holds the old DLL is a warning, never a build error. -->
  <PropertyGroup>
    <DevBundleDir>$(APPDATA)\Autodesk\ApplicationPlugins\CAD-Agent.bundle\Contents</DevBundleDir>
  </PropertyGroup>
  <Target Name="SyncDevBundle" AfterTargets="Build" Condition="Exists('$(DevBundleDir)')">
    <ItemGroup>
      <DevBundleFiles Include="$(OutDir)*.dll;$(OutDir)*.deps.json;$(OutDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(DevBundleFiles)" DestinationFolder="$(DevBundleDir)" ContinueOnError="WarnAndContinue" Retries="0" />
    <Message Importance="high" Text="CAD-Agent: bundle synced to $(DevBundleDir) (restart Civil 3D to load it)" />
  </Target>

</Project>
