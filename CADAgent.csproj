<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>CADAgent</AssemblyName>
    <RootNamespace>CADAgent</RootNamespace>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Auto-detect Civil 3D installation -->
  <PropertyGroup>
    <AutoCADPath>$([System.IO.Directory]::GetDirectories('C:\Program Files\Autodesk','AutoCAD 20*')[0])</AutoCADPath>
    <Civil3DPath>$(AutoCADPath)\C3D</Civil3DPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- UI is built entirely in code — exclude the XAML file from compilation -->
  <ItemGroup>
    <Page Remove="AgentPaletteControl.xaml" />
    <None Include="AgentPaletteControl.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- AutoCAD core references -->
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCADPath)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AutoCADPath)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AutoCADPath)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Civil3D database API -->
    <Reference Include="AeccDbMgd">
      <HintPath>$(Civil3DPath)\AeccDbMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- AEC base types required by Civil3D objects (Entity, Handle, etc.) -->
    <Reference Include="AecBaseMgd">
      <HintPath>$(AutoCADPath)\ACA\AecBaseMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
