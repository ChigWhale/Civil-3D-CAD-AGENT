<UserControl x:Class="CADAgent.AgentPaletteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="260" MinHeight="300">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Chat history -->
        <ScrollViewer Grid.Row="0" x:Name="ChatScroller"
                      VerticalScrollBarVisibility="Auto"
                      Margin="8,8,8,4">
            <StackPanel x:Name="ChatPanel" />
        </ScrollViewer>

        <!-- Status -->
        <TextBlock Grid.Row="1" x:Name="StatusLabel"
                   Foreground="#888888" FontSize="11" FontStyle="Italic"
                   Margin="10,0,10,4" TextWrapping="Wrap"/>

        <!-- Input bar -->
        <Grid Grid.Row="2" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="QuestionBox"
                     Grid.Column="0"
                     Background="#2D2D2D" Foreground="#DCDCDC"
                     CaretBrush="#DCDCDC"
                     BorderBrush="#555555" BorderThickness="1"
                     Padding="6,5" FontSize="13"
                     TextWrapping="Wrap" AcceptsReturn="False"
                     VerticalContentAlignment="Center"
                     KeyDown="OnKeyDown"/>

            <Button x:Name="AskButton"
                    Grid.Column="1"
                    Content="Ask"
                    Margin="6,0,0,0"
                    Padding="12,5"
                    FontSize="13"
                    Background="#0078D4" Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnAsk"/>
        </Grid>
    </Grid>
</UserControl>
